# All variables are optional. Copy this file to .env for local development
# (only picked up by `go run -tags dev`, see README.md) — a release binary
# only ever reads real OS/systemd environment variables.

# Upstream API the proxy forwards to. Defaults to https://api.anthropic.com.
# Point this at a LiteLLM proxy or any other Anthropic-compatible endpoint.
CLENS_PROXY_BASE_URL=

# If set, replaces the Authorization header on every forwarded request.
# Accepts a raw key ("sk-...") or a full "Scheme token" value; a raw key is
# automatically prefixed with "Bearer ".
CLENS_PROXY_AUTH_TOKEN=

# Extra headers injected into every forwarded request, one per line in
# "Header-Name: value" format, e.g.:
#   CLENS_PROXY_CUSTOM_HEADERS=X-Team: platform
CLENS_PROXY_CUSTOM_HEADERS=

# Listen addresses for the two servers. Defaults shown.
CLENS_PROXY_ADDR=:7801
CLENS_ADMIN_ADDR=:7802

# Where the SQLite DB and log file are written. Defaults shown — relative
# to the working directory the binary is run from. Set these to absolute
# paths if running from an arbitrary CWD (e.g. under systemd).
CLENS_DATA_DIR=data
CLENS_LOG_DIR=logs
